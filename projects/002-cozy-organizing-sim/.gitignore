# Godot import cache and editor state (regenerated by `godot --headless --import`)
game/.godot/
game/*.translation
# Godot export credentials (stored outside .godot/ by some versions)
game/export_credentials.cfg
# Fetched by tools/godot/fetch-gut.sh at the version pinned in build.env
game/addons/gut/
# Dev-only Steam app id file for running unpackaged builds through GodotSteam
game/steam_appid.txt
# Build outputs, test results and logs from tools/godot/build.sh
build/
# Editor / OS noise
*.tmp
.DS_Store
Thumbs.db

# Playtest builds made by tools/godot/build.sh (shared out of band, never committed)
playtest/builds/
