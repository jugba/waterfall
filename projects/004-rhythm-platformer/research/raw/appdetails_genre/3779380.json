a40b.poster.avif?t=1779350376\" width=1170 height=662 ><source src=\"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3779380\/extras\/117e674134e4ae4d55a226ea612fa40b.webm?t=1779350376\" type=\"video\/webm; codecs=vp9\"><source src=\"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3779380\/extras\/117e674134e4ae4d55a226ea612fa40b.mp4?t=1779350376\" type=\"video\/mp4\"><\/video><\/span><\/p><p class=\"bb_paragraph\" style=\"text-align: center\">Inspired by similar ultra-difficult platformers, your only objective in this game is to keep climbing!<\/p><p class=\"bb_paragraph\" style=\"text-align: center\">However, there are tons of monsters around, and they'll do their best to get in your way...<\/p><p class=\"bb_paragraph\" style=\"text-align: center\">Can you make it to the top?!<\/p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3779380\/extras\/d36a9582421f0b7c971b614786472296.poster.avif?t=1779350376\" width=756 height=124 ><source src=\"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3779380\/extras\/d36a9582421f0b7c971b614786472296.webm?t=1779350376\" type=\"video\/webm; codecs=vp9\"><source src=\"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3779380\/extras\/d36a9582421f0b7c971b614786472296.mp4?t=1779350376\" type=\"video\/mp4\"><\/video><\/span><\/p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3779380\/extras\/2e9029bcfa4dc01cebb1d108bd51f182.poster.avif?t=1779350376\" width=1170 height=658 ><source src=\"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/3779380\/extras\/2e9029bcfa4dc01cebb1d108b