class_name Beatmap
extends RefCounted
## Beat map data (res://data/beatmap.json, generated by tools/gen_music.py with the music).
## time = offset + beat * 60 / bpm, in seconds of AUDIO time.

const PATH := "res://data/beatmap.json"

var bpm := 120.0
var offset := 0.0
var beats_per_bar := 4
var length_beats := 0
var duration := 0.0
var music_path := ""
var events: Array = []  # [{beat, time, type}] sorted by time


static func load_default() -> Beatmap:
	return from_dict(Tuning.load_file(PATH))


static func from_dict(d: Dictionary) -> Beatmap:
	var m := Beatmap.new()
	m.bpm = float(d.get("bpm", 120.0))
	m.offset = float(d.get("offset", 0.0))
	m.beats_per_bar = int(d.get("beats_per_bar", 4))
	m.length_beats = int(d.get("length_beats", 0))
	m.duration = float(d.get("duration", 0.0))
	m.music_path = String(d.get("music", ""))
	for e in d.get("events", []):
		m.events.append({"beat": float(e["beat"]), "time": float(e["time"]), "type": String(e["type"])})
	m.events.sort_custom(func(a, b): return a["time"] < b["time"])
	return m


func beat_length() -> float:
	return 60.0 / bpm


func time_of_beat(beat: float) -> float:
	return offset + beat * beat_length()


## Continuous beat position for an audio time (beat 0 = offset).
func beat_at(time: float) -> float:
	return (time - offset) / beat_length()


func of_type(types: Array) -> Array:
	return events.filter(func(e): return types.has(e["type"]))
